    "defi-oracle",
    "web3",
    "blockchain",
    "price-tracker",
    "price-alert",
    "price-history",
    "price-api",
    "solana-price",
    "ethereum-price",
    "bitcoin-price",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "cursor",
    "llm",
    "ai-agent",
    "ai-tools",
    "nodejs",
    "javascript",
    "typescript"
  ],
  "scripts": {
    "start": "node mcp-server.js",
    "mcp-start": "node mcp-server.js",
    "test": "node --test test/*.test.js",
    "test:packed": "node test/packed-artifact.js",
    "test:live": "node test/live-smoke.js",
    "test:all": "npm test && npm run test:packed"
